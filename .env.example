# Copiar a .env (que no se commitea) y completar. Mantener al día con cada variable nueva.

# Base de datos (docker compose)
POSTGRES_DB=servife
POSTGRES_USER=servife
POSTGRES_PASSWORD=cambiar-esto

# Firma de los JWT, al menos 32 caracteres. Generar uno: openssl rand -base64 48
JWT_SECRETO=

# Orígenes permitidos para CORS (Expo web, Swagger), separados por coma
CORS_ORIGENES=http://localhost:8081

# Correo (recuperación de contraseña). En docker compose la api usa Mailpit y estos valores no hacen falta;
# al correr la api fuera de compose, por defecto apunta a localhost:1025. En producción: el SMTP real.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USUARIO=
MAIL_CONTRASENIA=
MAIL_REMITENTE=no-responder@servife.local
